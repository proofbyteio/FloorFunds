<Project Sdk="Microsoft.NET.Sdk">
  <!-- S2a reader contracts (spec §9, SSE2 F9). No package or project dependencies by design:
       Login.Entra (SSE2), the stand-in and the data project all reference this; it references nothing. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Login.Abstractions</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
</Project>
