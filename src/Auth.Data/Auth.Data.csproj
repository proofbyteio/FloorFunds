<Project Sdk="Microsoft.NET.Sdk">
  <!-- S2a data project: EF model, hand-written migrations + hand-kept snapshot, DB-backed readers.
       Runtime EF only; no design-time packages (TLD 2026-11-04 7:56 option b, 7:58 pins). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Auth.Data</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU3018 (revocation server unreachable) stays a WARNING: not suppressed, not made an error, revocation mode unchanged (TLD 7:56). -->
    <WarningsNotAsErrors>NU3018</WarningsNotAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <!-- Supplies Microsoft.Extensions.* so they are pruned, not fetched (TLD 7:58; no Microsoft.Extensions.* mapping). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="[10.0.3]" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="[10.0.3]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[10.0.14]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="[10.0.14]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" Version="[10.0.14]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Analyzers" Version="[10.0.14]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Login.Abstractions/Login.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ref-rows.json" LogicalName="Auth.Data.ref-rows.json" />
  </ItemGroup>
</Project>
