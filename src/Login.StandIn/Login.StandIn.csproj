<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Stand-in login service (SI1, Tier 1 dev tooling). Contract: tag contract-v1.
       Build guard (PLAN §3.5): builds only with -p:IncludeStandIn=true. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>Login.StandIn</RootNamespace>
  </PropertyGroup>
  <Target Name="StandInBuildFlag" BeforeTargets="Build" Condition="'$(IncludeStandIn)' != 'true'">
    <Error Text="Login.StandIn builds only with -p:IncludeStandIn=true (build plan §3.5)." />
  </Target>
</Project>
