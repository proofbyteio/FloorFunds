<Project Sdk="Microsoft.NET.Sdk">
  <!-- Scratch catalog-query boundary. No host, no token mapping, no new package. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Catalog.Query</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU3018</WarningsNotAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <!-- Supplies Microsoft.Extensions.* so the Npgsql graph is pruned, not fetched. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Catalog.Contracts/Catalog.Contracts.csproj" />
    <ProjectReference Include="../Catalog.Read/Catalog.Read.csproj" />
  </ItemGroup>
</Project>
