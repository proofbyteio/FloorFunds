      <package pattern="Npgsql" />
      <package pattern="Npgsql.EntityFrameworkCore.PostgreSQL" />
      <!-- TLD 2026-11-04 7:58: runtime EF, exact ids only, pinned [10.0.14] in Auth.Data -->
      <package pattern="Microsoft.EntityFrameworkCore" />
      <package pattern="Microsoft.EntityFrameworkCore.Relational" />
      <package pattern="Microsoft.EntityFrameworkCore.Abstractions" />
      <package pattern="Microsoft.EntityFrameworkCore.Analyzers" />
      <!-- DEC-145/146: offline phone parsing. Exact id, pinned [9.0.42] in Admin.Api. -->
      <package pattern="libphonenumber-csharp" />
    </packageSource>
  </packageSourceMapping>
  <config><add key="signatureValidationMode" value="require" /></config>
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
