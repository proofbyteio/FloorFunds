<Project Sdk="Microsoft.NET.Sdk">
  <!-- In-process scratch principal boundary. Not a listener, database, or deployed host. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Catalog.ScratchAuth</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same shared framework Admin.Api already uses. It supplies the token package's logging abstraction. This project does not listen. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="[8.19.2]" />
    <ProjectReference Include="..\Catalog.Transport\Catalog.Transport.csproj" />
  </ItemGroup>
</Project>
