<Project Sdk="Microsoft.NET.Sdk">
  <!-- S2a P3 in-process checks for Admin.Api against a TEST DB (ff_sse / ff_kit_*). No new packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU3018 (revocation server unreachable) stays a WARNING: not suppressed, not made an error (TLD 7:56). -->
    <WarningsNotAsErrors>NU3018</WarningsNotAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Admin.Api/Admin.Api.csproj" />
    <ProjectReference Include="../Auth.Issuer/Auth.Issuer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
