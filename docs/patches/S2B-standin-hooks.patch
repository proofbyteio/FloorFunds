diff --git a/src/Login.StandIn/EntraHost.cs b/src/Login.StandIn/EntraHost.cs
new file mode 100644
index 0000000..e065501
--- /dev/null
+++ b/src/Login.StandIn/EntraHost.cs
@@ -0,0 +1,54 @@
+// S2b hook (SSE2 proposal, for SSE to apply): bridges Login.Entra to the stand-in's audit feed and sessions.
+// Login.Entra never references the stand-in (TLD-S2B-04); only this adapter, owned by SSE, references Login.Entra.
+using System.Net;
+using System.Text.Json.Nodes;
+using Login.Entra.Contracts;
+using Login.Entra.Drafts;
+
+namespace Login.StandIn;
+
+public sealed class EntraStandInHost(StandInState st, string issuerPath) : IEntraHost
+{
+    public Task WriteAuditAsync(EntraAuditEvent ev, CancellationToken ct)
+    {
+        var now = st.Clock.Now;
+        var d = new JsonObject { ["provider_kind"] = ev.ProviderKind, ["username_hmac"] = Audit.UsernameHmac(ev.UsernameSubject) };
+        if (ev.Reason is not null) d["reason"] = ev.Reason;
+        if (ev.Amr is not null) d["amr"] = new JsonArray(ev.Amr.Select(a => (JsonNode)a!).ToArray()); // mapped amr only (TLD-S2B-12)
+        if (ev.AuthTime is { } at) d["auth_time"] = at.ToUnixTimeSeconds();
+        var scope = ev.LocationId is { } l ? new JsonObject { ["location_id"] = l.ToString("D") } : null;
+        st.Emit(Audit.Build(now, ev.EventType, ev.EventType.EndsWith("succeeded", StringComparison.Ordinal) ? "success" : "failure",
+            ev.UserId?.ToString("D"), d, scope));
+        return Task.CompletedTask;
+    }
+
+    public Task CompleteSignInAsync(HttpContext c, EntraSignInResult r)
+    {
+        var now = st.Clock.Now;
+        LoginSession s;
+        lock (st.Gate)
+        {
+            var uid = r.UserId.ToString("D");
+            var username = st.Users.Values.FirstOrDefault(u => u.UserId == uid)?.Username ?? uid; // username comes from OUR user row
+            s = new LoginSession { Sid = Guid.NewGuid().ToString(), UserId = uid, Username = username, Slug = "",
+                LocationId = r.LocationId.ToString("D"), AuthTime = r.AuthTime, LastSeen = now, Amr = r.Amr.ToArray() };
+            st.Auth.Sessions[s.Sid] = s;
+        }
+        c.Response.Cookies.Append(SignIn.SessionCookie, s.Sid, new CookieOptions { HttpOnly = true, SameSite = SameSiteMode.Lax, Path = issuerPath, Secure = c.Request.IsHttps });
+        c.Response.Redirect(r.ReturnUrl is { Length: > 0 } u && u.StartsWith(issuerPath + "/", StringComparison.Ordinal) ? u : issuerPath + "/hub");
+        return Task.CompletedTask;
+    }
+
+    public async Task RenderErrorAsync(HttpContext c, Guid? locationId)
+    {
+        c.Response.StatusCode = 503; c.Response.ContentType = "text/html; charset=utf-8";
+        await c.Response.WriteAsync($"<!doctype html><title>Sign-in</title><p data-testid=\"entra-error\">{WebUtility.HtmlEncode(SignIn.Generic)}</p>");
+    }
+
+    public Task RenderDatabaseFormAsync(HttpContext c, LocationLoginConfig cfg, bool viaFallback)
+    {
+        // The database form lives at the existing /l/{slug} route; the server decided (TLD-S2B-15), the browser just follows.
+        c.Response.Redirect(issuerPath + "/l/" + Uri.EscapeDataString(c.Request.RouteValues["slug"]?.ToString() ?? "") + (viaFallback ? "?fallback=1" : ""));
+        return Task.CompletedTask;
+    }
+}
