diff --git a/src/Login.StandIn/Program.cs b/src/Login.StandIn/Program.cs
index 1d2b063..94bd2c5 100644
--- a/src/Login.StandIn/Program.cs
+++ b/src/Login.StandIn/Program.cs
@@ -26,7 +26,28 @@ var issuer = (cfg["StandIn:Issuer"] ?? $"http://localhost:{ports.Front}/standin"
 var issuerPath = new Uri(issuer).AbsolutePath.TrimEnd('/');
 if (!issuerPath.Contains("/standin")) { Console.Error.WriteLine("Login.StandIn refused to start: issuer path must contain /standin"); return 2; }
 
+// S2b (SSE2 proposal): Entra sign-in, off unless StandIn:Entra:Enabled=true. Readers are fixture-backed
+// (TLD-S2B-10/22) until SSE's ILocationLoginConfigReader / IExternalLoginLookup implementations land.
+var entraOn = string.Equals(cfg["StandIn:Entra:Enabled"], "true", StringComparison.OrdinalIgnoreCase);
+if (entraOn)
+{
+    var fx = Login.Entra.Fixtures.EntraFixture.Load(cfg["StandIn:Entra:Fixture"] ?? throw new InvalidOperationException("StandIn:Entra:Fixture required"));
+    var store = new Login.Entra.Fixtures.FixtureEntraStore(fx);
+    builder.Services.AddSingleton<Login.Entra.Drafts.ILocationLoginConfigReader>(store);
+    builder.Services.AddSingleton<Login.Entra.Drafts.IExternalLoginLookup>(store);
+    builder.Services.AddSingleton<Login.Entra.Drafts.IAppUserReader>(store);
+    builder.Services.AddSingleton<Login.Entra.Drafts.ILocationAssignmentCheck>(store);
+    builder.Services.AddSingleton<Login.Entra.Drafts.ISecretResolver>(store);
+    builder.Services.AddSingleton<Login.Entra.Contracts.IEntraHost>(sp => new EntraStandInHost(sp.GetRequiredService<StandInState>(), issuerPath));
+    Login.Entra.EntraServiceCollectionExtensions.AddEntraLocationSignIn(builder.Services.AddAuthentication(), builder.Environment, o =>
+    {
+        o.CallbackPath = issuerPath + "/signin-entra";
+        o.AllowInsecureTestAuthority = builder.Environment.IsEnvironment("Testing");
+    });
+}
 builder.Services.AddAntiforgery(o => { o.Cookie.Name = "standin_af"; o.FormFieldName = "__RequestVerificationToken"; o.Cookie.Path = issuerPath; o.SuppressXFrameOptionsHeader = true; }); // F7: never SAMEORIGIN
+StandInState? stateRef = null;
+if (entraOn) builder.Services.AddSingleton(_ => stateRef ?? throw new InvalidOperationException("stand-in state not ready"));
 var app = builder.Build();
 // Slice 3: the allowlist runs first on every front request.
 var allow = new Allowlist(cfg["StandIn:AllowlistJson"] ?? "/tmp/sse-d0/allowlist-active.json");
@@ -41,6 +62,7 @@ Ui.IssuerPath = issuerPath; Ui.AgentPort = ports.Control; Ui.Load(Environment.Ge
 Ui.MapAssets(app); Handoff.SelfTest();
 Discovery.Map(app, issuerPath, disco, jwks);
 var state = new StandInState(cfg["StandIn:Fixtures"] ?? Path.Combine(AppContext.BaseDirectory, "fixtures.json"));
+stateRef = state;
 Control.Map(app, state);
 // SI1-13..16: tokens, sign-in, authorize, token/revoke/introspect/endsession.
 var tokens = new TokenIssuer(issuer, keys);
@@ -50,5 +72,23 @@ Handoff.Map(app, state, issuerPath, issuer, ports);
 Reenroll.Map(app, state, issuerPath, ports, cfg);
 SessionCap.Map(app, state, issuerPath, ports);
 CageStub.Map(app, state, issuerPath, ports);
+if (entraOn)
+{
+    app.UseAuthentication();
+    app.MapGet(issuerPath + "/entra/l/{slug}", (string slug, string? ret, HttpContext c) =>
+        c.RequestServices.GetRequiredService<Login.Entra.EntraLocationEndpoint>().HandleAsync(c, slug, ret));
+    app.MapGet(issuerPath + "/entra/logout", async (string location, HttpContext c) =>
+    {
+        // Ours first (endsession ordering, ENT-SO-01): revoke the stand-in session, then hand off to Entra.
+        if (!Guid.TryParse(location, out var lid)) return Results.BadRequest();
+        var to = await c.RequestServices.GetRequiredService<Login.Entra.EntraSignOut>().SignOutAsync(c, lid, issuer + "/hub", () =>
+        {
+            if (SignIn.CurrentSession(state, c, state.Clock.Now) is { } s) lock (state.Gate) { s.Revoked = true; state.Auth.Sessions.Remove(s.Sid); }
+            c.Response.Cookies.Delete(SignIn.SessionCookie, new CookieOptions { Path = issuerPath });
+            return Task.CompletedTask;
+        });
+        return Results.Redirect(to ?? issuerPath + "/hub");
+    });
+}
 app.Run();
 return 0;
