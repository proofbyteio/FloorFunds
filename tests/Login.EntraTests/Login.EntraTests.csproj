<Project Sdk="Microsoft.NET.Sdk">
  <!-- ENT-* tests (SSE2, S2b). xunit.v3.mtp-v2 4.0.2 is the already-approved test runner (same as tests/Cachd.Tests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(EntraUnlock)' != 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
    <ProjectReference Include="../../src/Login.Entra/Login.Entra.csproj" />
    <ProjectReference Include="../Login.FakeEntra/Login.FakeEntra.csproj" />
  </ItemGroup>
  <ItemGroup><None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
