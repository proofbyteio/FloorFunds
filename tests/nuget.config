<?xml version="1.0" encoding="utf-8"?>
<!-- S2b test projects (SSE2). nuget.org only, every package mapped (TLD-S2B-02). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
      <package pattern="Microsoft.IdentityModel.*" />
      <package pattern="System.IdentityModel.Tokens.Jwt" />
      <package pattern="Microsoft.Bcl.Cryptography" />
      <package pattern="xunit.*" />
      <package pattern="Microsoft.Testing.*" />
      <package pattern="Microsoft.Win32.Registry" />
      <package pattern="Microsoft.Extensions.*" />
      <package pattern="Microsoft.ApplicationInsights" />
      <package pattern="Microsoft.DiaSymReader" />
      <package pattern="System.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
