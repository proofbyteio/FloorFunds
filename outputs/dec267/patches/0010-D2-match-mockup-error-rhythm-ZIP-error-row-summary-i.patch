+.partner-form.partner-form--errors .actions { padding-top: 2px; }
+.partner-form.partner-form--errors .error-zip { margin-top: -2px; }
+.partner-form.partner-form--errors .field label,
+.partner-form.partner-form--errors .field .label { margin-bottom: 4px; }
 
 .page-head { margin: 0 0 20px; max-width: 720px; }
 .page-head h1 {
   margin: 0;
-  font-size: var(--font-size-xl, 1.5rem);
+  font-size: 22px;
   font-weight: 600;
   line-height: 1.25;
+  letter-spacing: -0.01em;
   color: var(--foreground, var(--color-text));
 }
 .page-lead {
   margin: 6px 0 0;
-  font-size: var(--font-size-sm, 0.875rem);
+  font-size: var(--text-sm, 0.875rem);
   color: var(--text-muted, var(--color-text-muted));
   font-weight: 400;
 }
-.partner-form.partner-form--errors ~ .page-head .page-lead,
+.page-head:has(+ .partner-form.partner-form--errors) { margin-bottom: 8px; }
 .page-head:has(+ .partner-form.partner-form--errors) .page-lead { display: none; }
