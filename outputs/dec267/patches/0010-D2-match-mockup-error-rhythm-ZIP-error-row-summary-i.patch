 .partner-form .hint-zip,
 .partner-form .error-zip {
   grid-column: 1 / -1;
   margin: -6px 0 0;
-  font-size: 12px;
+  font-size: var(--text-xs);
   line-height: 1.35;
   text-align: right;
   white-space: nowrap;
+  max-width: 100%;
+  box-sizing: border-box;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  min-width: 0;
 }
 .partner-form .hint-zip { color: var(--text-muted, var(--color-text-muted)); }
-.partner-form .error-text,
 .partner-form .error-zip {
+  color: var(--partner-error);
+  font-weight: 500;
+}
+.partner-form .error-text {
   margin: 5px 0 0;
-  font-size: 12px;
+  font-size: var(--text-xs);
   line-height: 1.35;
   color: var(--partner-error);
   font-weight: 500;
@@ -276,27 +311,33 @@ select.field__input {
 .partner-form .field.has-error .phone select {
   border-color: transparent;
 }
+/* D2(c): error summary tokens + heading flex + list spacing (HTML L294–L324). */
 .partner-form .error-summary {
   margin: 0 0 16px;
-  padding: 12px 16px;
+  padding: 12px 16px 12px;
