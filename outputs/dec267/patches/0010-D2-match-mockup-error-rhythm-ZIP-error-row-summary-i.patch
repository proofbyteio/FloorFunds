+  padding: 8px 8px 16px;
+}
+.shell__nav .admin-lockup__mark {
+  flex: 0 0 auto;
+  display: block;
+  width: 36px;
+  height: 36px;
+}
+.shell__nav .admin-lockup__name {
+  font-weight: 600;
+  font-size: 1rem;
+  line-height: 1.5;
+  color: #f0ede8;
+  max-width: 160px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  min-width: 0;
+}
 .shell__nav a {
   display: block;
   padding: var(--space-2) var(--space-3);
@@ -146,24 +173,23 @@ select.field__input {
 
 /* —— C7: Partner compact form (scoped; Client/Location unchanged) —— */
 .partner-form {
+  /* D2(a): card + grid rhythm from mock HTML L40–L42, L327–L353 */
   --partner-card-width: 720px;
   --partner-grid-gap-x: 12px;
   --partner-grid-gap-y: 16px;
   --error-summary-bg: #1c1010;
   --error-summary-border: #e44236;
   --partner-error: #e44236;
+  --text-xs: 0.75rem;
+  --text-sm: 0.875rem;
   width: 100%;
   max-width: var(--partner-card-width);
-  padding: 24px 32px;
+  padding: 24px 32px 24px;
   border-radius: 1rem;
   box-sizing: border-box;
-}
-.partner-form .field__input,
-.partner-form input,
-.partner-form select {
-  width: auto;
-  max-width: 100%;
-  box-sizing: border-box;
+  overflow: visible;
+  background: var(--surface, var(--color-surface));
+  border: 1px solid var(--hairline, var(--color-border));
 }
 .partner-form .section { margin: 0 0 22px; }
 .partner-form .section:last-of-type { margin-bottom: 20px; }
@@ -245,24 +271,33 @@ select.field__input {
 }
 .partner-form .hint {
   margin: 5px 0 0;
-  font-size: 12px;
+  font-size: var(--text-xs);
