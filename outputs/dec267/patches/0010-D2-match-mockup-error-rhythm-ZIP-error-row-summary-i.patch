   font-weight: 500;
   text-decoration: underline;
   text-underline-offset: 2px;
@@ -358,29 +399,38 @@ select.field__input {
   font-weight: 500;
   white-space: nowrap;
 }
+/* D2(a): error-state tightening from mock HTML L555–L571 */
 .partner-form.partner-form--errors .hint,
 .partner-form.partner-form--errors .hint-zip { display: none; }
