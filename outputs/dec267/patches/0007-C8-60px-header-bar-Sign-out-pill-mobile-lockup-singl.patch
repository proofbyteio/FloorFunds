diff --git a/ui/admin-shell/index.html b/ui/admin-shell/index.html
index 6c40038..a7b1fd4 100644
--- a/ui/admin-shell/index.html
+++ b/ui/admin-shell/index.html
@@ -13,10 +13,6 @@
 </head>
