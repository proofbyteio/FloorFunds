From 0ffd842ff97d55b5f2471f7b061d4f21ed1fbc76 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Sun, 15 Nov 2026 17:21:49 +0000
Subject: [PATCH 01/14] BUG-001: admin-shell banner and disabled-CTA contrast
 (tree-equal to 1b963b5e's theme.css change)

Co-authored-by: proofbyteio <proofbyteio@users.noreply.github.com>
---
 ui/admin-shell/theme.css | 34 ++++++++++++++++++++--------------
 1 file changed, 20 insertions(+), 14 deletions(-)

diff --git a/ui/admin-shell/theme.css b/ui/admin-shell/theme.css
index b38d93e..b1e98e0 100644
--- a/ui/admin-shell/theme.css
+++ b/ui/admin-shell/theme.css
@@ -70,18 +70,18 @@ p { margin: 0 0 var(--space-3); }
 .muted { color: var(--color-text-muted); font-size: var(--font-size-sm); }
 
 /* ---------- Mock-only chrome (NOT part of the product UI) ---------- */
-.mock-banner { background: var(--background); color: var(--surface); padding: .35rem 1rem; font-size: var(--font-size-sm); }
+.mock-banner { background: var(--background); color: var(--foreground); padding: .35rem 1rem; font-size: var(--font-size-sm); }
 .mock-banner strong { font-weight: 600; }
-.mock-states { background: var(--background); color: var(--surface); padding: .4rem 1rem; font-size: var(--font-size-sm);
+.mock-states { background: var(--background); color: var(--foreground); padding: .4rem 1rem; font-size: var(--font-size-sm);
                display: flex; flex-wrap: wrap; gap: .35rem .5rem; align-items: center; }
 .mock-states a { color: var(--foreground); text-decoration: none; padding: .1rem .55rem; border: 1px solid var(--border-control); border-radius: 999px; }
 .mock-states a[aria-current="true"] { background: var(--surface); color: var(--background); border-color: var(--surface); font-weight: 600; }
 .mock-states a:focus-visible { outline-color: var(--border-control); }
 .mock-states .label { color: var(--border-control); margin-right: .25rem; }
-.mock-states button { font: inherit; font-size: var(--font-size-xs); background: transparent; color: var(--surface); border: 1px dashed var(--text-muted); border-radius: 4px; padding: .1rem .5rem; cursor: pointer; margin-left: auto; }
-.mock-url { background: var(--surface); color: var(--background); font-family: ui-monospace, Menlo, Consolas, monospace; font-size: var(--font-size-xs);
+.mock-states button { font: inherit; font-size: var(--font-size-xs); background: transparent; color: var(--foreground); border: 1px dashed var(--text-muted); border-radius: 4px; padding: .1rem .5rem; cursor: pointer; margin-left: auto; }
+.mock-url { background: var(--surface); color: var(--foreground); font-family: ui-monospace, Menlo, Consolas, monospace; font-size: var(--font-size-xs);
             padding: .3rem 1rem; border-bottom: 1px solid var(--border-control); }
-.mock-url::before { content: "URL (mock): "; color: var(--foreground); }
+.mock-url::before { content: "URL (mock): "; color: var(--text-muted); }
 
 /* Annotation tags and panel (toggle with the "Hide notes" button) */
 .tag { display: inline-block; font-size: .6875rem; font-weight: 500; line-height: 1.4; padding: 0 .4rem; border-radius: 4px;
@@ -143,7 +143,11 @@ body.notes-hidden .tag, body.notes-hidden .annot { display: none !important; }
 .btn-primary:disabled .btn-primary__press,
 .btn-primary[disabled] .btn-primary__press,
 .btn-primary[aria-disabled="true"] .btn-primary__press {
+  /* BUG-001: muted grey on gold fails AA; use surface + muted text instead. */
   color: var(--disabled-text);
+  background-color: var(--surface);
+  background-image: none;
+  border-color: var(--hairline);
   box-shadow: none;
   opacity: 1;
 }
@@ -159,14 +163,16 @@ body.notes-hidden .tag, body.notes-hidden .annot { display: none !important; }
           margin-bottom: var(--space-4); font-size: var(--font-size-sm); }
 .banner__icon { flex: none; font-weight: 700; }
 .banner__title { font-weight: var(--font-weight-semibold); display: block; }
-.banner--error   { background: var(--color-danger-soft); border-color: var(--color-danger); }
+/* BUG-001: soft banner fills are light; do not inherit body --color-text. Use DEC-227 banner text tokens. */
+.banner--error   { background: var(--color-danger-soft); border-color: var(--color-danger); color: var(--error-banner-text); }
 .banner--error .banner__icon { color: var(--color-danger); }
-.banner--info    { background: var(--color-info-soft); border-color: var(--color-info); }
+.banner--info    { background: var(--color-info-soft); border-color: var(--color-info); color: var(--info-banner-text); }
 .banner--info .banner__icon { color: var(--color-info); }
-.banner--warning { background: var(--color-warning-soft); border-color: var(--warning-banner-text); }
-.banner--warning .banner__icon { color: var(--foreground); }
-.banner--success { background: var(--color-success-soft); border-color: var(--color-success); }
+.banner--warning { background: var(--color-warning-soft); border-color: var(--warning-banner-text); color: var(--warning-banner-text); }
+.banner--warning .banner__icon { color: var(--warning-banner-text); }
+.banner--success { background: var(--color-success-soft); border-color: var(--color-success); color: var(--success-banner-text); }
 .banner--success .banner__icon { color: var(--color-success); }
+.banner p { color: var(--banner-body); margin: 0; }
 
 /* ---------- Signed-in shell: icon rail + top bar (matches reference) ---------- */
 .app-shell { display: grid; grid-template-columns: var(--rail-width) 1fr; min-height: calc(100vh - 110px); }
@@ -181,7 +187,7 @@ body.notes-hidden .tag, body.notes-hidden .annot { display: none !important; }
 .breadcrumb [aria-current] { color: var(--color-text); font-weight: var(--font-weight-medium); }
 .topbar__spacer { flex: 1; }
 .chip { display: inline-flex; align-items: center; gap: .35rem; font-size: var(--font-size-sm); border: 1px solid var(--color-input-border); border-radius: var(--radius-sm); padding: .3rem .6rem; background: var(--surface); }
-.avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--background); color: var(--surface); display: grid; place-items: center; font-size: var(--font-size-xs); font-weight: 600; }
+.avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--primary); color: var(--text-on-primary); display: grid; place-items: center; font-size: var(--font-size-xs); font-weight: 600; }
 .main { padding: var(--space-5); }
 .main__inner { max-width: 1040px; margin: 0 auto; }
 
@@ -247,7 +253,7 @@ body.notes-hidden .tag, body.notes-hidden .annot { display: none !important; }
 .action-row { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-4) 0; }
 /* Mock-only */
 .mock-frame { border: 2px dashed var(--border-control); background: var(--surface); margin: var(--space-5) auto; max-width: 720px; }
-.mock-frame__label { background: var(--background); color: var(--surface); font-size: var(--font-size-xs); padding: var(--space-1) var(--space-2); }
+.mock-frame__label { background: var(--background); color: var(--foreground); font-size: var(--font-size-xs); padding: var(--space-1) var(--space-2); }
 .qr-mock { width: 148px; height: 148px; border: 1px solid var(--color-input-border); display: block; margin: 0 0 var(--space-2); }
 /* Replace inline styles (TL review §23 S8). Additions only; DECISIONS D-29. */
 .rail__logo { margin-bottom: var(--space-2); }
@@ -264,7 +270,7 @@ body.notes-hidden .tag, body.notes-hidden .annot { display: none !important; }
 /* Added Nov 2 ~11:4x AM PT (DECISIONS D-38 / D-49 / D-50 / D-51); listed in README stable names */
 .rule-lead { margin: 0 0 var(--space-1); }
 .cage-actions { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
-.cage-action[aria-disabled="true"] { opacity: 1; background: var(--surface); color: var(--background); border-style: dashed; }
+.cage-action[aria-disabled="true"] { opacity: 1; background: var(--surface); color: var(--disabled-text); border-style: dashed; }
 .cage-action__state { margin-left: var(--space-2); font-size: var(--font-size-xs); font-weight: var(--font-weight-semibold); border: 1px solid var(--border-control); border-radius: 999px; padding: 0 .4rem; }
 .progress-steps { list-style: none; padding: 0; margin: 0 0 var(--space-4); }
 .progress-steps li { padding: var(--space-1) 0; }
@@ -298,4 +304,4 @@ body.notes-hidden .tag, body.notes-hidden .annot { display: none !important; }
 .notif-bell { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--radius-md); border: 1px solid var(--color-input-border); background: var(--surface); color: var(--color-text); text-decoration: none; flex-shrink: 0; }
 .notif-bell:hover { background: var(--color-page); }
 .notif-bell:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
-.notif-bell__badge { position: absolute; top: 4px; right: 4px; min-width: 16px; height: 16px; padding: 0 4px; border-radius: 8px; background: var(--color-danger); color: var(--surface); font-size: 10px; font-weight: var(--font-weight-semibold); line-height: 16px; text-align: center; }
+.notif-bell__badge { position: absolute; top: 4px; right: 4px; min-width: 16px; height: 16px; padding: 0 4px; border-radius: 8px; background: var(--color-danger); color: var(--text-on-danger); font-size: 10px; font-weight: var(--font-weight-semibold); line-height: 16px; text-align: center; }
