{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cachd:login:contract:v1:audit-events",
  "title": "Audit events the contract tests may assert, contract v1 (DRAFT v1-d2)",
  "description": "Event list [SRC: PLAN §3.1 L148-161; LD §8 L414-424]. Envelope names [SRC: AUD §7A.4]; login-specific mapping [SRC: LD §8 L421]. The two differ (flat partner_id/client_id/location_id in AUD vs scope.* in LD) [CONFLICT -> OQ-23]; draft uses AUD flat names plus LD's actor.session_id, target, action. Only fields the login service writes are listed; relay-assigned fields (received_at, sequence, prev_hash, hash) are not asserted.",
  "type": "object",
  "allOf": [{ "$ref": "#/$defs/envelope" }],
  "oneOf": [
    { "$ref": "#/$defs/auth.login.succeeded" },
    { "$ref": "#/$defs/auth.login.failed" },
    { "$ref": "#/$defs/auth.account.locked" },
    { "$ref": "#/$defs/auth.account.unlocked" },
    { "$ref": "#/$defs/auth.mfa" },
    { "$ref": "#/$defs/auth.password.changed" },
    { "$ref": "#/$defs/auth.session.revoked" },
    { "$ref": "#/$defs/auth.app.signed_in" },
    { "$ref": "#/$defs/auth.app_access.denied" },
    { "$ref": "#/$defs/fields_not_stated" }
  ],
  "$defs": {
    "id": { "type": "string", "format": "uuid" },
    "envelope": {
      "type": "object",
      "required": ["event_id", "schema", "schema_version", "category", "event_type", "occurred_at", "outcome", "is_audit", "actor", "source", "details"],
      "properties": {
        "event_id": { "description": "UUIDv7, idempotency key [SRC: AUD §7A.4].", "$ref": "#/$defs/id" },
        "schema": { "const": "cachd.log" },
        "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "category": { "description": "Events category [SRC: LD §8 L410]. Literal value [ASSUME A-30 -> OQ-23].", "const": "event" },
        "event_type": { "type": "string", "pattern": "^auth\\.[a-z_]+\\.[a-z_]+$" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "location_tz": { "type": "string" },
        "partner_id": { "$ref": "#/$defs/id" },
        "client_id": { "description": "AUD name for the Cachd client (not the OAuth client) [SRC: AUD §7A.4]; see OQ-23.", "$ref": "#/$defs/id" },
        "location_id": { "$ref": "#/$defs/id" },
        "workstation_id": { "description": "If known [SRC: LD L421].", "type": "string" },
        "actor": {
          "type": "object",
          "required": ["user_id"],
          "properties": {
            "user_id": { "description": "= sub; null when the user is unknown (failed sign-in) [ASSUME A-31 -> OQ-24].", "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "session_id": { "description": "= login_session_id [SRC: LD L421].", "type": "string" },
            "roles": { "type": "array", "items": { "type": "string" } },
            "channel": { "type": "string" }
          }
        },
        "target": {
          "type": "object",
          "properties": { "type": { "type": "string" }, "id": { "type": "string" } }
        },
        "action": { "type": "string" },
        "source": {
          "description": "service, versions [SRC: AUD §7A.4]; ip, user_agent [SRC: LD L414, L421].",
          "type": "object",
          "required": ["service"],
          "properties": {
            "service": { "type": "string" },
            "app_version": { "type": "string" },
            "config_version": { "type": "string" },
            "ip": { "type": "string" },
            "user_agent": { "type": "string" }
          }
        },
        "outcome": { "description": "Values [ASSUME A-32 -> OQ-23]; success and denied appear in LD L421, L423.", "enum": ["success", "failure", "denied"] },
        "correlation_id": { "type": "string" },
        "trace_id": { "type": "string" },
        "producer_seq": { "type": "integer" },
        "ingest_path": { "const": "outbox" },
        "is_audit": { "const": true },
        "x_standin": { "description": "Stand-in events only [ASSUME A-33 -> OQ-25].", "const": true },
        "details": { "type": "object" }
      }
    },
    "provider_kind": { "enum": ["database", "entra"] },
    "auth.login.succeeded": {
      "description": "[SRC: LD §8 L414].",
      "properties": {
        "event_type": { "const": "auth.login.succeeded" },
        "outcome": { "const": "success" },
        "details": {
          "required": ["provider_kind", "amr"],
          "properties": {
            "provider_kind": { "$ref": "#/$defs/provider_kind" },
            "tenant_id": { "type": "string" }, "amr": { "type": "array" }, "acrs": {}, "acct": {}, "idp": { "type": "string" },
            "auth_time": { "type": "integer" }
          }
        }
      }
    },
    "auth.login.failed": {
      "description": "[SRC: LD §8 L415; PLAN L150]. Never the password.",
      "properties": {
        "event_type": { "const": "auth.login.failed" },
        "outcome": { "const": "failure" },
        "details": {
          "required": ["username_hmac", "reason", "provider_kind"],
          "properties": {
            "username_hmac": { "description": "HMAC-SHA256 with a secret key, hex [SRC: LD L415]; field name and encoding [ASSUME A-34 -> OQ-24]. Stand-in key is test-only.", "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "reason": {
              "description": "Known codes: remote_session [SRC: LD L415]; locked, mfa_missing, tenant_mismatch, stale_auth_time [SRC: PLAN L146]; bad_credentials, outbox_unavailable [ASSUME A-35 -> OQ-24]. The full list is open.",
              "type": "string",
              "pattern": "^[a-z_]+$",
              "examples": ["bad_credentials", "locked", "mfa_missing", "tenant_mismatch", "stale_auth_time", "remote_session"]
            },
            "provider_kind": { "$ref": "#/$defs/provider_kind" }
          },
          "not": { "anyOf": [{ "required": ["password"] }, { "required": ["username"] }] }
        }
      }
    },
    "auth.account.locked": {
      "description": "[SRC: LD §8 L416]; 10 tries / 30 min [SRC: PLAN L34].",
      "properties": {
        "event_type": { "const": "auth.account.locked" },
        "details": { "required": ["lock_until"], "properties": { "lock_until": { "type": "string", "format": "date-time" } } }
      }
    },
    "auth.account.unlocked": {
      "description": "Who unlocked, user unlocked, identity check used [SRC: LD §8 L416].",
      "properties": {
        "event_type": { "const": "auth.account.unlocked" },
        "target": { "required": ["type", "id"], "properties": { "type": { "const": "user" } } },
        "details": { "required": ["identity_check"], "properties": { "identity_check": { "type": "string" } } }
      }
    },
    "auth.mfa": {
      "description": "[SRC: LD §8 L417].",
      "properties": {
        "event_type": { "enum": ["auth.mfa.enrolled", "auth.mfa.succeeded", "auth.mfa.failed", "auth.mfa.reset"] },
        "details": { "required": ["method"], "properties": { "method": { "description": "totp | recovery_code | entra [ASSUME A-36 -> OQ-24].", "type": "string" } } }
      }
    },
    "auth.password.changed": {
      "description": "[SRC: LD §8 L418].",
      "properties": {
        "event_type": { "const": "auth.password.changed" },
        "details": { "required": ["channel"], "properties": { "channel": { "type": "string" } } }
      }
    },
    "auth.session.revoked": {
      "description": "reason, actor [SRC: LD §8 L420]. Reason values [ASSUME A-37 -> OQ-24].",
      "properties": {
        "event_type": { "const": "auth.session.revoked" },
        "details": { "required": ["reason"], "properties": { "reason": { "type": "string", "examples": ["sign_out", "admin_revoke", "idle_timeout", "refresh_reuse"] } } }
      }
    },
    "auth.app.signed_in": {
      "description": "[SRC: LD §8 L421; PLAN L156, S1 check 2]. One per code issued.",
      "properties": {
        "event_type": { "const": "auth.app.signed_in" },
        "outcome": { "const": "success" },
        "action": { "const": "login" },
        "actor": { "required": ["user_id", "session_id"] },
        "target": { "required": ["type", "id"], "properties": { "type": { "const": "app" }, "id": { "description": "app_id; hub for the hub.", "type": "string" } } },
        "details": {
          "required": ["method", "auth_time", "amr"],
          "properties": {
            "method": { "enum": ["interactive", "sso", "hub_handoff"] },
            "prompt": { "enum": ["login", "none"] },
            "max_age": { "type": "integer" },
            "auth_time": { "description": "Original auth_time for hub_handoff.", "type": "integer" },
            "amr": { "type": "array" }
          }
        }
      },
      "required": ["target", "action"]
    },
    "auth.app_access.denied": {
      "description": "[SRC: LD §8 L423; PLAN §1.2 L51, L157, S1 checks 1, 4, 4a].",
      "properties": {
        "event_type": { "const": "auth.app_access.denied" },
        "outcome": { "const": "denied" },
        "target": { "required": ["type", "id"], "properties": { "type": { "const": "app" } } },
        "details": {
          "required": ["reason"],
          "properties": { "reason": { "enum": ["no_role", "remote_session", "attestation_invalid"] } }
        }
      },
      "required": ["target"]
    },
    "fields_not_stated": {
      "description": "In the list [SRC: PLAN L158-160; LD §8 L424] but no fields are stated anywhere [OQ-25]. Envelope only until answered.",
      "properties": {
        "event_type": { "enum": ["auth.refresh.reuse_detected", "auth.break_glass.used", "auth.session.location_switched"] }
      }
    }
  }
}
